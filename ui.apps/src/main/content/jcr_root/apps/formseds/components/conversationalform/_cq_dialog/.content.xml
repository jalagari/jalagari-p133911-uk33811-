<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"  xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Properties"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[cf.authoring]"
    >
    <content
        jcr:primaryType="nt:unstructured"
        granite:class="cmp-conversational__editor"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <chatbottitle
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Chatbot Title"
                        name="./chatbotTitle"/>
                    <initalmessages
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                            fieldLabel="Initial Messages">
                        <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Message"
                                name="./initialMessages"/>
                    </initalmessages>
                    <conversationmode
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                            fieldLabel="Mode"
                            name="./mode">
                        <items jcr:primaryType="nt:unstructured">
                            <conversational
                                    jcr:primaryType="nt:unstructured"
                                    text="Conversational Form"
                                    value="conversational"
                                    checked="{Boolean}true">
                            </conversational>
                            <conversationalgenaisite
                                    jcr:primaryType="nt:unstructured"
                                    text="Conversational Site Assistant - GenAI"
                                    value="conversationalgenaisite">
                            </conversationalgenaisite>
                            <conversationalgenaiform
                                    jcr:primaryType="nt:unstructured"
                                    text="Conversational Form Assistant - GenAI"
                                    value="conversationalgenaiform">
                            </conversationalgenaiform>
                        </items>
                    </conversationmode>
                    <conversationendpoint
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Conversational Endpoint"
                            name="./conversationEndpoint"/>
                    <genaiendpoint
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="Smart Assistance Endpoint"
                            name="./genaiEndpoint"/>
                </items>
            </column>
        </items>
    </content>
</jcr:root>